{
    "name": "sierratecnologia/porteiro",
    "description": "porteiro",
    "type": "library",
    "keywords": [
        "porteiro"
    ],
    "homepage": "https://github.com/sierratecnologia/porteiro",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "laravel/passport": "^13.8",
        "laravel/socialite": "^5.31",
        "creativeorange/gravatar": "^1.0",
        "ricardosierra/validate": "^0.4.4",
        "sierratecnologia/crypto": "^2.0",
        "sierratecnologia/muleta": "^2.0",
        "sierratecnologia/pedreiro": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.68",
        "laravel/dusk": "^8.6",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "phpro/grumphp": "^2.12",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "netresearch/jsonmapper": "^3.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "authors": [
        {
            "name": "RiCa Soluções",
            "email": "contato@ricasolucoes.com.br",
            "homepage": "https://ricasolucoes.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Porteiro\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Porteiro\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Porteiro\\PorteiroProvider"
            ],
            "aliases": {
                "Porteiro": "Porteiro\\Facades\\Porteiro"
            },
            "dont-discover": []
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "2.1.0"
}
